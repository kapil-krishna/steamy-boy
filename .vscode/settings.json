{
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    },
    // Only suggest real members of the type, not every word in the file.
    "editor.wordBasedSuggestions": "off",
    "editor.snippetSuggestions": "bottom",
    "editor.suggest.showWords": false
  },

  // Type-aware completion, go-to-definition, find usages and rename (like IntelliJ).
  "python.languageServer": "Pylance",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,

  // Grey hints showing inferred types and parameter names, like IntelliJ's inlay hints.
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.callArgumentNames": "partial",

  "python.testing.pytestEnabled": true
}
