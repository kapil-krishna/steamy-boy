# Copy to .env and adjust. .env is git-ignored. Docker Compose and the app both read it.
POSTGRES_PASSWORD=steamy_boy
POSTGRES_PORT=5432
DATABASE_URL=postgresql://steamy_boy:steamy_boy@localhost:5432/steamy_boy

# The agent's model (D15): any OpenAI-compatible endpoint. Prices are USD per million
# tokens, for the cost record; leave them at 0 for local models.
#
# Cloud, via OpenRouter:
AGENT_MODEL__BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL__NAME=
AGENT_MODEL__API_KEY=
AGENT_MODEL__INPUT_USD_PER_MTOK=0
AGENT_MODEL__OUTPUT_USD_PER_MTOK=0
#
# Local, via Ollama (no key, no cost):
# AGENT_MODEL__BASE_URL=http://localhost:11434/v1
# AGENT_MODEL__NAME=

# Optional: tried when the agent model keeps failing with transient errors (R20).
# AGENT_FALLBACK_MODEL__BASE_URL=
# AGENT_FALLBACK_MODEL__NAME=
# AGENT_FALLBACK_MODEL__API_KEY=
